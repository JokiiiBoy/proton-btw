+static int compare_view_base( const void *key, const struct rb_entry *entry )
+{
+    client_ptr_t base = *(const client_ptr_t *)key;
+    const struct memory_view *view = RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
+
+    if (base < view->base) return -1;
+    if (base > view->base) return 1;
+    return 0;
+}
+
+void init_process_views_tree( struct process *process )
+{
+    rb_init( &process->views_tree, compare_view_base );
+}
+
+/* the view with the highest base not above addr (views never overlap) */
+static struct memory_view *find_view_at_or_below( struct process *process, client_ptr_t addr )
+{
+    struct rb_entry *entry = process->views_tree.root;
+    struct memory_view *best = NULL;
+
+    while (entry)
+    {
+        struct memory_view *view = RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
+        if (view->base <= addr)
+        {
+            best = view;
+            entry = entry->right;
+        }
+        else entry = entry->left;
+    }
+    return best;
+}
+
